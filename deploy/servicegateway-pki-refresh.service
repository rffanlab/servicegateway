[Unit]
Description=ServiceGateway automatic management CRL maintenance
After=servicegateway-agent.service servicegateway-edge.service
Requires=servicegateway-agent.service
ConditionPathExists=/etc/servicegateway/pki-auto/passphrase.cred

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/e5-apps/servicegateway/current
LoadCredentialEncrypted=pki-passphrase:/etc/servicegateway/pki-auto/passphrase.cred
RuntimeDirectory=servicegateway-pki-refresh
RuntimeDirectoryMode=0700
ExecStart=/srv/e5-apps/servicegateway/current/.venv/bin/python -I -m servicegateway.deploykit pki-auto-refresh
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/servicegateway /root/servicegateway-access /var/lib/servicegateway
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
