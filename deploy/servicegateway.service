[Unit]
Description=ServiceGateway management API and console
After=network-online.target servicegateway-agent.service
Wants=network-online.target
Requires=servicegateway-agent.service

[Service]
Type=simple
User=servicegateway
Group=servicegateway
WorkingDirectory=/srv/e5-apps/servicegateway/current
EnvironmentFile=/etc/servicegateway/app.env
ExecStart=/srv/e5-apps/servicegateway/current/.venv/bin/uvicorn servicegateway.main:create_app --factory --host 127.0.0.1 --port 19092 --workers 1 --no-proxy-headers --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/e5-data/servicegateway /srv/e5-workspaces/servicegateway /srv/e5-logs/servicegateway
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
