[Unit]
Description=ServiceGateway isolated Nginx data plane
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=/run/servicegateway-edge/nginx.pid
RuntimeDirectory=servicegateway-edge
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/nginx -t -c /etc/servicegateway/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/servicegateway/nginx.conf
ExecReload=/usr/sbin/nginx -s reload -c /etc/servicegateway/nginx.conf
ExecStop=/bin/kill -s QUIT $MAINPID
TimeoutStopSec=90
Restart=on-failure
RestartSec=3
KillMode=mixed
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/servicegateway-edge /var/lib/servicegateway/edge /srv/e5-logs/servicegateway

[Install]
WantedBy=multi-user.target
