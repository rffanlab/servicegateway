# Never commit .env. URL-encode special characters in database credentials.
SG_DATABASE_URL=mysql+pymysql://servicegateway:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:3306/servicegateway?charset=utf8mb4
# Remote deployment fails closed: configure an exact dedicated HTTPS admin origin.
# Never share the admin hostname with proxied business applications.
SG_SECURE_COOKIE=true
SG_DEPLOYMENT_MODE=remote
SG_PUBLIC_ORIGIN=https://admin.invalid
SG_SESSION_IDLE_MINUTES=30
# Opaque service-user bearer token lifetime; WeChat users can login again after expiry.\nSG_BUSINESS_TOKEN_DAYS=30\nSG_AUTH_SECRET_FILE=/etc/servicegateway/auth-secret
SG_AGENT_SOCKET=/run/servicegateway-agent/agent.sock
SG_POLICY_FILE=/etc/servicegateway/policy.json
SG_MONITOR_ENABLED=true
SG_HEALTH_INTERVAL=30
SG_ADMIN_PORT=19092
